# ─── General ──────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-string
PROJECT_NAME="SmartFeed AI"
VERSION=1.0.0

# ─── Database ────────────────────────────────────────────
# Database - Use SQLite for development, PostgreSQL for production
# SQLite: sqlite+aiosqlite:///./smartfeed.db
# PostgreSQL: postgresql+asyncpg://smartfeed:smartfeed@localhost:5432/smartfeed
DATABASE_URL=sqlite+aiosqlite:///./smartfeed.db
DATABASE_SYNC_URL=sqlite:///./smartfeed.db

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── RabbitMQ ────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# ─── Qdrant ──────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ─── Elasticsearch ───────────────────────────────────────
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_API_KEY=

# ─── MinIO (S3-compatible storage) ──────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=smartfeed
MINIO_SECURE=false

# ─── Celery ──────────────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── AI / LLM ───────────────────────────────────────────
# Local embedding model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Classification model
CLASSIFICATION_MODEL_NAME=facebook/bart-large-mnli

# Summarization model
SUMMARIZATION_MODEL_NAME=facebook/bart-large-cnn

# NER model
NER_MODEL_NAME=en_core_web_lg

# Translation model
TRANSLATION_MODEL_NAME=Helsinki-NLP/opus-mt-en-{lang}

# OpenAI (optional - for enhanced summarization/chat)
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# ─── News API ───────────────────────────────────────────
NEWSAPI_KEY=
NEWSAPI_BASE_URL=https://newsapi.org/v2

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Rate Limiting ──────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# ─── CORS ───────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
